# Copy to .env and fill in. Razorpay TEST MODE keys only.
# Dashboard -> Settings -> API Keys (test mode), and Settings -> Webhooks.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Set when creating the webhook in the Razorpay dashboard. If this is empty the
# app accepts unsigned webhooks and logs a warning -- local dev only.
RAZORPAY_WEBHOOK_SECRET=

LOG_LEVEL=INFO
DEFAULT_STRATEGY=agentic
HOLDOUT_FRACTION=0.15

# Local MySQL. Root is fine for dev; use a dedicated user beyond that.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=recovery
